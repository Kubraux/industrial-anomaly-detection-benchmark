 def auprc(labels, scores):
     ap = average_precision_score(labels, scores)
     return ap
+
+def _arrays(labels, scores):
+    def array(value):
+        if hasattr(value, 'detach'):
+            value = value.detach().cpu().numpy()
+        return np.asarray(value).reshape(-1)
+    labels, scores = array(labels), array(scores).astype(np.float64)
+    if labels.shape != scores.shape or labels.size == 0:
+        raise ValueError("Labels and continuous scores must have equal nonempty shapes.")
+    if set(np.unique(labels)) != {0, 1}:
+        raise ValueError("AUROC requires normal=0 and anomaly=1, both present.")
+    if not np.isfinite(scores).all():
+        raise ValueError("Non-finite anomaly score.")
+    return labels, scores
+
+
+def score_report(labels, scores):
+    labels, scores = _arrays(labels, scores)
+    span = scores.max()-scores.min()
+    normalized = (scores-scores.min())/span if span > 0 else np.zeros_like(scores)
+    raw_auc = roc(labels, scores)
+    report = dict(raw_auc=raw_auc, normalized_auc=roc(labels, normalized),
+                  one_minus_auc_diagnostic_only=1-raw_auc,
+                  min=float(scores.min()), max=float(scores.max()))
+    for label, name in ((0, 'normal'), (1, 'anomaly')):
+        group = scores[labels == label]
+        report[name] = dict(count=int(group.size), mean=float(group.mean()),
+                            median=float(np.median(group)), min=float(group.min()),
+                            max=float(group.max()))
+    return report, normalized
