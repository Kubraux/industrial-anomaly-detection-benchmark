+        )
+        max_scores = (
+            segmentations.reshape(len(segmentations), -1)
+            .max(axis=-1)
+            .reshape(-1, 1, 1, 1)
+        )
+        segmentations = (segmentations - min_scores) / (max_scores - min_scores)
+        segmentations = np.mean(segmentations, axis=0)
+
+        anomaly_labels = [
+            x[1] != "good" for x in test_data.dataset.data_to_iterate
+        ]
