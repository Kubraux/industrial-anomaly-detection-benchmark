{
  "parameters": {
    "backbone": "wideresnet50",
    "weights": "IMAGENET1K_V1",
    "layers": [
      "layer2",
      "layer3"
    ],
    "pretrain_embed_dimension": 1536,
    "target_embed_dimension": 1536,
    "patchsize": 3,
    "embedding_size": 256,
    "meta_epochs": 40,
    "gan_epochs": 4,
    "noise_std": 0.015,
    "dsc_hidden": 1024,
    "dsc_layers": 2,
    "dsc_margin": 0.5,
    "pre_proj": 1,
    "dsc_lr": 0.0002,
    "projection_lr": 0.0001,
    "batch_size": 8,
    "resize": 329,
    "imagesize": 288,
    "seed": 0,
    "num_workers": 0,
    "cpu_threads": 2,
    "train_backbone": false,
    "cos_lr": false,
    "mix_noise": 1
  },
  "data_path": "${PROJECT_ROOT}\\archive",
  "python": "3.10.11",
  "torch": "2.14.0+cpu",
  "torchvision": "0.29.0+cpu",
  "numpy": "2.2.6",
  "source": "https://github.com/DonaldRR/SimpleNet/blob/main/run.sh"
}